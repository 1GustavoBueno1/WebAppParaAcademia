rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNumberBetween(value, min, max) {
      return value is number && value >= min && value <= max;
    }
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- dados de cada usuário ----------

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && incoming().keys().hasOnly(['displayName', 'createdAt'])
        && incoming().keys().hasAll(['displayName', 'createdAt'])
        && incoming().displayName is string
        && incoming().displayName.size() >= 2
        && incoming().displayName.size() <= 50
        && incoming().createdAt == request.time;

      // Só o nome pode mudar.
      allow update: if isOwner(uid)
        && incoming().diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && incoming().displayName is string
        && incoming().displayName.size() >= 2
        && incoming().displayName.size() <= 50;

      allow delete: if false;
      match /plans/{planId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['name', 'days', 'templateId'])
          && incoming().keys().hasAll(['name', 'days'])
          && isText(incoming().name, 100)
          && incoming().days is list
          && incoming().days.size() >= 1
          && incoming().days.size() <= 30
          && (!('templateId' in incoming()) || isText(incoming().templateId, 100));
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['date', 'planDayId', 'exercises', 'note'])
          && incoming().keys().hasAll(['date', 'planDayId', 'exercises'])
          && isDate(incoming().date)
          && isText(incoming().planDayId, 64)
          && incoming().exercises is list
          && incoming().exercises.size() >= 1
          && incoming().exercises.size() <= 100
          && (!('note' in incoming()) || isText(incoming().note, 500));
      }
      match /exerciseState/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['lastDate', 'lastSets', 'suggestedLoadKg', 'suggestedReps'])
          && incoming().keys().hasAll(['lastDate', 'lastSets', 'suggestedLoadKg', 'suggestedReps'])
          && isDate(incoming().lastDate)
          && incoming().lastSets is list
          && incoming().lastSets.size() <= 20
          && (incoming().suggestedLoadKg == null || isNumberBetween(incoming().suggestedLoadKg, 0, 1000))
          && isNumberBetween(incoming().suggestedReps, 1, 600);
      }
      match /metrics/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['date', 'weightKg', 'waistCm'])
          && incoming().keys().hasAny(['weightKg', 'waistCm'])
          && isDate(incoming().date)
          && incoming().date == date
          && (!('weightKg' in incoming()) || isNumberBetween(incoming().weightKg, 20, 400))
          && (!('waistCm' in incoming()) || isNumberBetween(incoming().waistCm, 30, 250));
      }
      match /customExercises/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && exerciseId.matches('^custom-.+$')
          && exerciseId.size() <= 64
          && incoming().keys().hasOnly(['name', 'unit'])
          && incoming().keys().hasAll(['name', 'unit'])
          && isText(incoming().name, 100)
          && incoming().unit in ['reps', 'seconds'];
      }
    }
  }
}
